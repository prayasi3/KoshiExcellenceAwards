<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let Apache serve existing files and directories normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router handles all remaining application routes.
  RewriteRule ^ index.html [L]
</IfModule>
